# Copy this file to .env (gitignored) and fill in real values. Never commit
# .env, and never put a real value from below back into a tracked source
# file — these were previously hardcoded in config.py/llm_azure.py, which is
# exactly the "architecture info leaked on a public repo" problem this file
# exists to avoid repeating.

# Created by running redline_discovery/db/setup.sql in pgAdmin.
PG_HOST=localhost
PG_PORT=5433
PG_DB=aiplaybook
PG_USER=aiplaybook_app
PG_PASSWORD=

# Key Vault this project reads MPact/CobbleStone and Azure OpenAI secrets from.
AZURE_KEY_VAULT_URL=https://your-vault-name.vault.azure.net/

# Key Vault SECRET NAMES (not values) for the MPact OAuth client used to call
# the CobbleStone API. Ask a teammate who already has access, or look them
# up in the Key Vault directly.
MPACT_OAUTH_URL_SECRET_NAME=
MPACT_CLIENT_ID_SECRET_NAME=
MPACT_CLIENT_SECRET_SECRET_NAME=

# CobbleStone's API base URL for this tenant.
COBBLESTONE_BASE_URL=https://your-tenant.cobblestone.software/api2/CSSAPI/V2

# Key Vault SECRET NAMES (not values) for the Azure OpenAI (AI Foundry)
# endpoint/API key used by llm_azure.py.
AOAI_ENDPOINT_SECRET_NAME=
AOAI_API_KEY_SECRET_NAME=
