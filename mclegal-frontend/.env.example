# Copy to .env (gitignored, never commit real values) and fill in the real
# tenant URL. Never hardcode it directly in source — this repo is public.
#
# The request-detail URL pattern for opening one specific CobbleStone/mpact
# request in a browser. {requestId} is replaced with the actual request id.
VITE_MPACT_REQUEST_URL_TEMPLATE=https://your-tenant.cobblestone.software/core/ContractRequestDetails.aspx?ID={requestId}&from=QuickSearch.aspx
